# Dependencies and package-manager caches
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.pnpm-store/

# Next.js, build output and caches
.next/
out/
build/
dist/
.turbo/
.cache/
*.tsbuildinfo
next-env.d.ts

# Test and browser automation output
coverage/
.nyc_output/
playwright-report/
test-results/
playwright/.cache/

# Local configuration and secrets; keep sanitized examples shareable
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx

# AI assistant local state and credentials (shared instructions stay tracked)
.claude/settings.local.json
.claude/history.jsonl
.claude/projects/
.codex/auth.json
.codex/sessions/
.codex/history.jsonl
.cursor/.cache/
.mcp.local.json

# Hosting, editor and OS files
.vercel/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tmp
*.temp
